{
  "extraKnownMarketplaces": {
    "caveman": { "source": { "source": "github", "repo": "JuliusBrussee/caveman" } },
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "impeccable": { "source": { "source": "github", "repo": "pbakaus/impeccable" } },
    "taste-skill": { "source": { "source": "github", "repo": "Leonxlnx/taste-skill" } },
    "claude-plugins-official": { "source": { "source": "github", "repo": "anthropics/claude-plugins-official" } },
    "mattpocock": { "source": { "source": "github", "repo": "mattpocock/skills" } }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "impeccable@impeccable": true,
    "taste-skill@taste-skill": true,
    "frontend-design@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud-setup.sh",
            "timeout": 600,
            "statusMessage": "Setting up the cloud session"
          }
        ]
      }
    ]
  }
}
